# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ห้าม commit ไฟล์ .env)

# --- Backend ---
PORT=3001
# ต่อ Postgres ที่รันจาก docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dnd_guild
# บน Render ให้ตั้งเป็น true
DATABASE_SSL=false

# --- AI (Gemini) ---
LLM_API_KEY=your_api_key_here
# ชื่อโมเดล (ไม่ใส่ก็ได้ ระบบใช้ค่าเริ่มต้นใน ai.js)
# ถ้าขึ้น error 404 ให้ดูชื่อโมเดลที่ใช้ได้ใน Google AI Studio แล้วใส่ที่นี่
# LLM_MODEL=
